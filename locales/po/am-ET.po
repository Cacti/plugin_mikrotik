msgid "Connect to the MikroTik API over SSL (api-ssl, port 8729). Enable the api-ssl service under IP > Services on the device before turning this on."
msgstr "ከMikroTik API ጋር በSSL (api-ssl፣ ወደብ 8729) በኩል ይገናኙ። ይህን ከማብራትዎ በፊት በመሣሪያው ላይ በIP > Services ስር የapi-ssl አገልግሎቱን ያንቁ።"

#: setup.php
msgid "No"
msgstr "አይ"

#: setup.php
msgid "Yes"
msgstr "አዎ"

#: setup.php
msgid "An SSL connection to the MikroTik api-ssl service (port 8729) could not be established, so SSL cannot be enabled. Enable and verify the api-ssl service under IP > Services on the device to use SSL."
msgstr "ወደ MikroTik api-ssl አገልግሎት (ወደብ 8729) የSSL ግንኙነት መፍጠር ስላልተቻለ SSL መንቃት አይችልም። SSLን ለመጠቀም በመሣሪያው ላይ በIP > Services ስር የapi-ssl አገልግሎትን ያንቁ እና ያረጋግጡ።"

#: setup.php
msgid "Yes (currently unreachable)"
msgstr "አዎ (በአሁኑ ጊዜ የማይደረስበት)"

#: setup.php
msgid "SSL"
msgstr "SSL"

#: setup.php
msgid "MikroTik Credentials"
msgstr "የMikroTik ማረጋገጫዎች"

#: setup.php
msgid "Read Only User"
msgstr "የንባብ ብቻ ተጠቃሚ"

#: setup.php
msgid "Provide a read only username for the MikroTik."
msgstr "ለMikroTik የንባብ ብቻ የተጠቃሚ ስም ያቅርቡ።"

#: setup.php
msgid "Password"
msgstr "የይለፍ ቃል"

#: setup.php
msgid "Provide the read only password for this MikroTik. Leave this field blank to keep the currently stored password."
msgstr "ለዚህ MikroTik የንባብ ብቻ የይለፍ ቃል ያቅርቡ። በአሁኑ ጊዜ የተቀመጠውን የይለፍ ቃል ለማቆየት ይህን መስክ ባዶ ይተዉት።"

#: setup.php
msgid "SSL not present on this device"
msgstr "በዚህ መሣሪያ ላይ SSL የለም"

#: setup.php
msgid "Connection Result"
msgstr "የግንኙነት ውጤት"

#: setup.php
msgid "Ok if Cacti can connect to the MikroTik over its API port."
msgstr "Cacti በAPI ወደቡ በኩል ከMikroTik ጋር መገናኘት ከቻለ እሺ ይላል።"

#: setup.php
msgid "SSL is enabled but the api-ssl port (8729) is not reachable; connection not tested."
msgstr "SSL ነቅቷል ግን የapi-ssl ወደብ (8729) ሊደረስበት አልቻለም፤ ግንኙነቱ አልተሞከረም።"

#: setup.php
msgid "Connected Successfully"
msgstr "በተሳካ ሁኔታ ተገናኝቷል"

#: setup.php
msgid "Connection Failed"
msgstr "ግንኙነት አልተሳካም"

#: setup.php
msgid "Allow Unverified API TLS Certificates"
msgstr "ያልተረጋገጡ የAPI TLS ሰርተፊኬቶችን ፍቀድ"

#: setup.php
msgid "Disable certificate and hostname verification for RouterOS API connections. This can expose API credentials to an impersonated device. Leave unchecked and install trusted device certificates whenever possible."
msgstr "ለRouterOS API ግንኙነቶች የሰርቲፊኬት እና የአስተናጋጅ ስም ማረጋገጫን ያሰናክሉ። ይህ የAPI ምስክርነቶችን ለአስመሳይ መሣሪያ ሊያጋልጥ ይችላል። በተቻለ መጠን ምልክት ሳይደረግበት ይተዉትና የታመኑ የመሣሪያ ሰርቲፊኬቶችን ይጫኑ።"

